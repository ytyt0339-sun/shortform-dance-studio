# 실수로 뭔가 올라가는 일이 없도록, 전부 무시하고 필요한 것만 되살린다.
# (키 파일, 사용자 영상, 실험용 스크립트가 섞여 있는 폴더라 이 방식이 안전하다)
/*

!.gitignore
!.dockerignore
!Dockerfile
!requirements.txt
!render.yaml
!README.md

!app/
app/*
!app/studio.py
!app/pipeline.py
!app/reference.py
!app/video.py
!app/poster_text.py
!app/get_fonts.py

!app/static_studio/
app/static_studio/*
!app/static_studio/index.html
!app/static_studio/sample/
app/static_studio/sample/*
!app/static_studio/sample/style_3d.jpg
!app/static_studio/sample/style_doodle.jpg
!_hf_space/
_hf_space/*

# 새 구조(v2) — Codespaces 가 이걸 돌린다
!v2/
v2/*
!v2/app/
v2/app/*
!v2/app/studio.py
!v2/app/pipeline.py
!v2/app/reference.py
!v2/app/video.py
!v2/app/poster_text.py
!v2/app/get_fonts.py
!v2/app/store.py
!v2/app/static_studio/
v2/app/static_studio/*
!v2/app/static_studio/index.html
!v2/app/static_studio/sample/
v2/app/static_studio/sample/*
!v2/app/static_studio/sample/style_3d.jpg
!v2/app/static_studio/sample/style_doodle.jpg
!v2/app/ops.py
!v2/Dockerfile
!v2/requirements.txt
!v2/.dockerignore
!v2/deploy_cloudrun.sh
!v2/lambda/
v2/lambda/*
!v2/lambda/Dockerfile
!v2/lambda/handler.py
!v2/lambda/requirements.txt

# Cloudflare Worker (화면·API). node_modules 는 뺀다.
!worker/
!deploy/
deploy/*
!deploy/aws.sh
!deploy/cloudflare.sh
worker/*
!worker/src/
!worker/src/*.js
!worker/wrangler.toml
!worker/package.json
!worker/public/
worker/public/*
!worker/public/index.html
!worker/public/sample/
worker/public/sample/*
!worker/public/sample/*.jpg

!.devcontainer/
